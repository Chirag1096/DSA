    internal class QueueCostlyDequeue
    {
        Stack<int> s1 = new Stack<int>();
        Stack<int> s2 = new Stack<int>();


        public void Enqueue(int item)
        {
            s1.Push(item);
        }

        public int? Dequeue()
        {
            if (s1.Count == 0)
            {
                Console.WriteLine("Queue is empty.");
                return null;
            }

            while (s1.Count != 0)
            {
                s2.Push(s1.Pop());
            }

            int top = s2.Pop();
        
            while (s2.Count != 0)
            {
                s1.Push(s2.Pop());
            }

            return top;
        }
    }
}

