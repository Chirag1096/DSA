public class Solution {
    public int MinimumDifference(int[] nums, int k) {
        if(nums.Length ==0 || nums.Length == 1)
        {
            return 0;
        }
        Array.Sort(nums);
        int left = 0;
        int right = k-1;
        int min = int.MaxValue;
        while(right < nums.Length)
        {
            int minDiff = nums[right] - nums[left];
            if(min > minDiff)
            {
                min = minDiff;
            }
            left++;
            right++;
        }
        return min;
    }
}
