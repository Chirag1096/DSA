o(log n)
public class Solution {
    public int LBinarySearch(int[] nums, int left, int right, int target)
    {
        if(left > right)
        {
            return -1;
        }
        int mid = (left + right)/2;
        if(nums[mid] == target)
        {
            int ans = LBinarySearch(nums, left, mid-1, target);
            if(ans != -1)
            {
                return ans;
            }
            else
            {
                return mid;
            }
        }
        else if(nums[mid] < target)
        {
            return LBinarySearch(nums, mid+1, right, target);
        }
        else
        {
            return LBinarySearch(nums, left, mid-1, target);
        }
    }

        public int RBinarySearch(int[] nums, int left, int right, int target)
    {
        if(left > right)
        {
            return -1;
        }
        int mid = (left + right)/2;
        if(nums[mid] == target)
        {
            int ans = RBinarySearch(nums, mid+1, right, target);
            if(ans != -1)
            {
                return ans;
            }
            else
            {
                return mid;
            }
        }
        else if(nums[mid] < target)
        {
            return RBinarySearch(nums, mid+1, right, target);
        }
        else
        {
            return RBinarySearch(nums, left, mid-1, target);
        }
    }
    public int[] SearchRange(int[] nums, int target) {
        int lIndex = LBinarySearch(nums, 0, nums.Length-1, target);
        int rIndex = RBinarySearch(nums, 0, nums.Length-1, target);
        return new int[] {lIndex, rIndex};
    }
}
