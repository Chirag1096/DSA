public class Solution {
    public int BinarySearch(int[] nums, int left, int right, int h)
    {
        if(left > right)
        {
            return left;
        }
        int mid = left+(right-left)/2;
        long totalHours = 0;
        int i=0;
        while(i<nums.Length)
        {
            totalHours += (nums[i]+mid-1)/mid;
            i++;
        }
        if(totalHours <= h)
        {
            return BinarySearch(nums, left, mid-1, h);
        }
        else
        {
            return BinarySearch(nums, mid+1, right, h);
        }
    }
    public int MinEatingSpeed(int[] piles, int h) {
        int max = int.MinValue;
        for(int i=0; i< piles.Length; i++)
        {
            if(piles[i]>max)
            {
                max = piles[i];
            }
        }
        return BinarySearch(piles, 1, max, h);

    }
}
