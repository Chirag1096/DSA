public class Solution {
    public int BinarySearchOnArray(int[] nums, int k, int max, int sum)
    {
        if(max > sum)
        {
            return max;
        }
        int mid = max+(sum-max)/2;
        int i=0, total = 0, splits = 1;
        while(i<nums.Length)
        {
            if(total+nums[i] <= mid)
            {
                total += nums[i];
            }
            else
            {
                total = nums[i];
                splits++;
            }
            i++;
        }
        if(splits <= k)
        {
            return BinarySearchOnArray(nums, k, max, mid-1);
        }
        else
        {
            return BinarySearchOnArray(nums, k, mid+1, sum);
        }
    }
    public int SplitArray(int[] nums, int k) {
        int sum = nums.Sum();
        int max = nums.Max();
        return BinarySearchOnArray(nums, k, max, sum);
    }
}
